---
// Shared terminal block. Used twice on the page (hero, closing CTA), which is
// the autoloops pattern: the install is never more than one screen away.
// W-3: the copy button copies the exact source lines, so the text lives in a
// data attribute rather than being scraped from the DOM (which carries the
// `$ ` prompt markers).
interface Props {
  lines: string[];
  /** Tighter padding for the hero, where the block sits under the subhead. */
  compact?: boolean;
  /**
   * Single-line 36px bar, the supermemory hero shape: the command sits inline
   * under the button pair and takes its width, with the copy control inside the
   * bar rather than floated over it. Only sensible for one line.
   */
  bar?: boolean;
}
const { lines, compact = false, bar = false } = Astro.props;
const block = lines.join('\n');
---

<div class:list={['terminal', { compact, bar }]}>
  <!-- hidden until JS wires it up, so it is never a dead control (W-1) -->
  <button class="copy" type="button" data-clip={block} aria-label="Copy to clipboard" hidden>
    <svg class="ic-copy" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        d="M5.5 5.5V3a1 1 0 0 1 1-1H13a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1h-2.5m-8-5H9a1 1 0 0 1 1 1V13a1 1 0 0 1-1 1H2.5a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z"
      />
    </svg>
    <svg class="ic-done" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <path fill="none" stroke="currentColor" stroke-width="1.7" d="m2.5 8.5 3.5 3.5 7.5-8" />
    </svg>
  </button>
  <pre><code>{
    lines.map((line, i) => (
      // the bar is one line tall, so the trailing newline would double its height
      <span class="line"><span class="prompt" aria-hidden="true">$ </span>{bar && i === lines.length - 1 ? line : line + '\n'}</span>
    ))
  }</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.clip ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Clipboard API unavailable (insecure context, denied permission)
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.classList.add('done');
      btn.setAttribute('aria-label', 'Copied');
      setTimeout(() => {
        btn.classList.remove('done');
        btn.setAttribute('aria-label', 'Copy to clipboard');
      }, 2000);
    });
  });
</script>

<style>
  /* Inset code surface: the deepest of the three greys, recessed whether it
     sits on the page white (hero) or on a panel (closing CTA).

     Dashed frame, as supermemory sets its own install pill:
     as supermemory sets its own install pill —
     `border: 1px dashed rgba(11,16,21,.2)` — here in the page's own ink. A
     dashed rule reads as "this is a thing to copy" rather than as a panel edge,
     and it is the same language the prose links use. */
  .terminal {
    position: relative;
    background: var(--surface);
    border: 1px dashed color-mix(in srgb, var(--text) 20%, transparent);
    padding: 20px 22px;
  }

  .terminal.compact {
    padding: 16px 18px;
  }

  /* Bar variant, on supermemory's metrics: 36px tall, 14px of side padding,
     12.5px mono, with the copy control an inline 22px button at the right end
     rather than a floating 32px one. */
  .terminal.bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    background: var(--panel);
    transition: border-color 0.18s ease;
  }

  .terminal.bar:hover {
    border-color: color-mix(in srgb, var(--text) 40%, transparent);
  }

  /* The three declarations below re-assert what the phone breakpoints at the
     foot of this sheet turn on for the block variant (wrapping, a hanging
     indent, a 38px button). A one-line bar must not do any of that. */
  .terminal.bar pre {
    flex: 1;
    min-width: 0;
    padding-right: 0;
    overflow-x: auto;
  }

  /* Dimmer than the block variant's: in this layout the command is a reference,
     not the call to action, and their bar sets it at 60% of the ink too.

     line-height must clear the font's own line box (JetBrains Mono is 1.32em
     ascent-to-descent). At the measured 1 the glyphs overflowed the line box,
     and because `overflow-x: auto` forces the other axis from `visible` to
     `auto`, that overflow raised a scrollbar inside a box holding one short
     command. 1.5 contains the glyphs — and any taller fallback face — so
     neither axis ever overflows. The bar centres its content, so the extra
     leading changes nothing about where the line sits. */
  .terminal.bar code {
    font-size: 0.78125rem; /* 12.5px */
    line-height: 1.5;
    white-space: pre;
    color: var(--text-dim);
  }

  .terminal.bar .line {
    display: inline;
    padding-left: 0;
    text-indent: 0;
  }

  .terminal.bar .copy {
    position: static;
    /* the button precedes the <pre> in the DOM, where it has to stay for the
       absolutely-positioned default; flex order puts it back on the right */
    order: 2;
    flex: none;
    width: 22px;
    height: 22px;
    border: 0;
    background: transparent;
  }

  .terminal.bar .copy:hover {
    background: transparent;
  }

  pre {
    margin: 0;
    /* the pre (not the terminal) scrolls, so the copy button stays pinned to
       the corner instead of riding along with long lines */
    overflow-x: auto;
    /* long lines can pass under the button; this keeps the line ends legible
       once scrolled to */
    padding-right: 40px;
  }

  code {
    display: block;
    line-height: 1.75;
    color: var(--text);
  }

  .prompt {
    color: var(--copper);
    user-select: none;
  }

  .copy {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    /* solid surface fill so text scrolling beneath never shows through */
    background: var(--surface);
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .copy:hover {
    color: var(--text);
    background: var(--panel-hi);
    border-color: var(--line-hi);
  }

  .copy .ic-done {
    display: none;
  }

  .copy.done {
    color: var(--copper);
    border-color: var(--trace);
  }

  .copy.done .ic-copy {
    display: none;
  }

  .copy.done .ic-done {
    display: block;
  }

  @media (max-width: 720px) {
    .terminal {
      padding: 18px 16px;
    }

    /* Smaller type on phone so longer commands fit more comfortably. */
    code {
      font-size: 0.8125rem; /* 13px */
    }

    /* icon-only fits in the corner even at 320px; grow the tap target */
    .copy {
      width: 38px;
      height: 38px;
      top: 6px;
      right: 6px;
    }
  }

  /* Phone: wrap long commands instead of scrolling them off the right edge,
     where the tail (…<api-key>, …brief.md) got clipped and read as broken. The
     hanging indent keeps continuation lines aligned past the "$ " prompt; the
     inherited 40px right padding keeps the first rows clear of the copy button. */
  @media (max-width: 560px) {
    pre {
      overflow-x: visible;
    }

    code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      font-size: 0.75rem; /* 12px — narrowest phones */
    }

    .line {
      display: block;
      padding-left: 2ch;
      text-indent: -2ch;
    }
  }
</style>
