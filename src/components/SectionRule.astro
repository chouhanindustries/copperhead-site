---
// Section divider in supermemory.ai's shape, measured off their page at a
// 1440px viewport:
//
//   ───────────────────────────────────────────  full-bleed 1px #E7EAEE
//   │  ❯ PRODUCT CATALOG                     │  40px band, inside the frame
//   │────────────────────────────────────────│  1px, frame width (rule to rule)
//   │                                        │
//
// Their vertical frame rules sit at x=104 and x=1335 — a 1231px column centred
// in 1440 — and the band's label is inset a further 33px from them. That is
// this site's geometry already: a var(--maxw) box whose .wrap adds 32px of
// padding. So the outer rule bleeds the full viewport, the inner rule spans the
// --maxw box (landing exactly on the vertical rules global.css draws), and the
// label rides the .wrap padding.
interface Props {
  /** Set uppercase by CSS; write it in sentence case. */
  label: string;
}
const { label } = Astro.props;
---

<div class="rule">
  <div class="band">
    <div class="band-in">
      <span class="label">
        <svg class="chev" viewBox="0 0 16 16" width="10" height="10" aria-hidden="true" focusable="false">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m6 3 5 5-5 5"></path>
        </svg>
        {label}
      </span>
    </div>
  </div>
</div>

<style>
  /* The outer rule is this element's own top border, so it bleeds the viewport
     the way theirs does — it crosses the vertical frame rules rather than
     stopping at them. */
  .rule {
    border-top: 1px solid var(--line);
  }

  .band {
    max-width: var(--maxw);
    margin-inline: auto;
    border-bottom: 1px solid var(--line);
  }

  .band-in {
    display: flex;
    align-items: center;
    height: 40px;
    padding-inline: 32px;
  }

  /* Reference-designator type: mono, uppercase, widely tracked, and quiet. The
     chevron is drawn rather than set as ❯ — the mono face is subset to the
     codepoints the copy uses and does not carry it. */
  .label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chev {
    flex: none;
    color: var(--copper);
  }

  @media (max-width: 720px) {
    .band-in {
      height: 34px;
      padding-inline: 22px; /* matches .wrap's phone padding */
    }

    .label {
      letter-spacing: 0.1em;
    }
  }
</style>
